# =============================================================================
# ccm-dashboard environment variables
# Copy to .env for local dev, or set these in the Vercel project settings.
# Never commit a real .env (it is gitignored).
# =============================================================================

# --- Required ---------------------------------------------------------------

# MySQL connection string. Format:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE?ssl={"rejectUnauthorized":true}
# Most hosted providers require TLS — keep the ssl param for production.
DATABASE_URL=

# Secret used to sign session/JWT cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The openId of the account that should be treated as the owner/admin.
OWNER_OPEN_ID=

# --- Manus platform integration (OAuth + built-in services) -----------------
# These come from the Manus platform the app was scaffolded on. If you deploy
# OFF Manus, the Manus OAuth sign-in and built-in Forge services will not work,
# but email + password worker login (the primary auth path) still does.
VITE_APP_ID=
OAUTH_SERVER_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- AI note generation (AWS Bedrock — HIPAA: covered by the AWS BAA) --------
# Set BEDROCK_MODEL_ID to route "Generate with AI" through AWS Bedrock instead of
# the Forge endpoint. On Lambda/EC2 the IAM role supplies credentials (no keys here);
# the role needs the bedrock:InvokeModel permission and the model must be enabled in
# the Bedrock console (Model access) for your region.
#   e.g. BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=
# BEDROCK_REGION defaults to AWS_REGION (auto-set on Lambda), else us-east-1.
BEDROCK_REGION=

# --- Email (optional; password-reset / invite notifications) ----------------
RESEND_API_KEY=
INVITE_EMAIL_FROM=

# --- Runtime ----------------------------------------------------------------
# Set automatically by the platform in production. Local dev uses "development".
# NODE_ENV=production
# PORT=3000
